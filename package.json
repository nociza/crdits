{
  "name": "crdits",
  "version": "0.1.0",
  "description": "A local-first credit-card value ledger and agent skill.",
  "homepage": "https://github.com/nociza/crdits#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nociza/crdits.git"
  },
  "bugs": {
    "url": "https://github.com/nociza/crdits/issues"
  },
  "license": "MIT",
  "private": false,
  "bin": {
    "crdits": "./bin/crdits.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vinext dev",
    "dev:api": "node --watch server/index.mjs",
    "build": "vinext build",
    "start": "node scripts/start.mjs",
    "api": "node server/index.mjs",
    "crdits": "node bin/crdits.mjs",
    "catalog:validate": "node bin/crdits.mjs catalog validate",
    "catalog:refresh-plan": "node scripts/teleclaw-refresh.mjs",
    "teleclaw:poll": "node integrations/teleclaw/crdits-reminders.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "test:unit": "node --test tests/catalog.test.mjs tests/client.test.mjs tests/db.test.mjs tests/engine.test.mjs tests/service.test.mjs tests/teleclaw.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test": "npm run test:unit && npm run catalog:validate && npm run build && npm run test:render",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2"
  },
  "type": "module"
}
